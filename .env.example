# ─────────────────────────────────────────────────────────────────────────────
# BarBudget environment configuration
# Copy to `.env` and fill in. `.env` is git-ignored and NOT baked into the image.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────────────────────
# These feed the `db` container's superuser + the app's connection string.
POSTGRES_USER=barbudget
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=barbudget

# App -> DB connection string. Host is the compose service name `db`.
# (Inside Docker the port is the container's internal 5432, NOT a published host port.)
DATABASE_URL=postgresql://barbudget:change-me-strong-password@db:5432/barbudget?schema=public

# ── NextAuth (admin credentials provider) ─────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
# Public URL NextAuth uses for callbacks. Locally this is the localhost port;
# in production set it to your Cloudflare-terminated custom domain.
NEXTAUTH_URL=http://localhost:3000

# Seed / bootstrap admin account (used by the seed script to create admin_users row).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ── Internal cron endpoints ───────────────────────────────────────────────────
# pg_cron (via pg_net) calls the app's /api/cron/* routes with this bearer token.
# Must match what the SQL cron jobs send. Generate with: openssl rand -hex 32
CRON_SECRET=change-me-openssl-rand-hex-32
# How pg_net reaches the app from inside the Docker network (service name + internal port).
APP_INTERNAL_URL=http://app:3000

# ── Google AdSense ────────────────────────────────────────────────────────────
# Publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX. Client-side => NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_INFEED=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_CALCULATOR=

# ── TheCocktailDB ─────────────────────────────────────────────────────────────
# Premium/supporter key. Falls back to the public test key "1" in development.
# NOTE: confirm the exact premium base URL from your account dashboard — the
# premium path can differ from the free-tier `/api/json/v1/1/` form.
COCKTAILDB_API_KEY=1
COCKTAILDB_BASE_URL=https://www.thecocktaildb.com/api/json/v1

# ── Affiliate feed sync ───────────────────────────────────────────────────────
# Comma-separated list of feed definitions the price-sync job downloads.
# Format per entry: retailer|network|format(csv|xml)|url
# Example:
# AFFILIATE_FEEDS=Total Wine|flexoffers|csv|https://feeds.flexoffers.example/totalwine.csv,Wine.com|rakuten|xml|https://feeds.rakuten.example/winecom.xml
AFFILIATE_FEEDS=
# Optional per-network auth header sent with every feed download (if required).
AFFILIATE_FEED_AUTH_HEADER=
# Trigram similarity threshold (0-1) above which a feed row auto-matches a bottle.
PRICE_MATCH_THRESHOLD=0.45
